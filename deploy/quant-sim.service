# /etc/systemd/system/quant-sim.service — quant-sim server (24/7 live paper trading).
# Install: see docs/server.md. Paths assume the layout used there:
#   app:  /opt/quant-sim/current  (a symlink to the release in use)
#   data: /var/lib/quant-sim      (SQLite file; created by systemd, owned by the service user)
[Unit]
Description=quant-sim server (live paper trading on Binance public market data)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=quant-sim
Group=quant-sim
WorkingDirectory=/opt/quant-sim/current
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8787
Environment=QS_DATA_DIR=/var/lib/quant-sim
# Behind Caddy with HTTPS the cookie is marked Secure automatically (X-Forwarded-Proto from 127.0.0.1).
# Environment=QS_SECURE_COOKIES=1
# Environment=QS_MAX_RUNNING=5
# Node permission model: no child processes or native addons; files readable only under /opt/quant-sim and the
# data dir, writable only in the data dir (worker threads inherit it). Network is not restricted by Node 24.
ExecStart=/usr/bin/node --permission --allow-fs-read=/opt/quant-sim --allow-fs-read=/var/lib/quant-sim --allow-fs-write=/var/lib/quant-sim --allow-worker --disable-warning=ExperimentalWarning --disable-warning=SecurityWarning /opt/quant-sim/current/server/dist/main.js
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20
StateDirectory=quant-sim
StateDirectoryMode=0700
# Hardening (no MemoryDenyWriteExecute: V8's JIT needs writable+executable memory).
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/quant-sim
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictRealtime=yes
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete
SystemCallArchitectures=native
UMask=0077
# MemoryDenyWriteExecute is deliberately NOT set: V8's JIT needs writable+executable memory (the server would
# crash at startup). The sandbox (node:vm + identifier gate) and the Node permission model in ExecStart are the
# containment layers; this is documented in docs/server.md §12.
# A per-session worker thread is capped at ~288 MB (resourceLimits); MemoryMax bounds the whole process, so keep
# it above QS_MAX_RUNNING × worker cap + the main thread. Default below suits QS_MAX_RUNNING=5 (see docs §12).
MemoryMax=1800M

[Install]
WantedBy=multi-user.target
