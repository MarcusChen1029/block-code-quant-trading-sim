{
  "name": "quant-sim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "server:build": "tsc -p server && vite build --config server/vite.config.ts",
    "server:start": "node --disable-warning=ExperimentalWarning server/dist/main.js",
    "server:set-password": "node --disable-warning=ExperimentalWarning server/dist/set-password.js",
    "server:dev": "npm run server:build && npm run server:start",
    "server:typecheck": "tsc -p server"
  },
  "dependencies": {
    "blockly": "^13.3.0",
    "lightweight-charts": "^5.2.1"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
